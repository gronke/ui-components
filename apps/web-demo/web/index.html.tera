<!doctype html>
<!-- The stylesheet ships both theme variants; the site wears light and the
     terminal pane wears dark for this preview — either side could flip. -->
<html lang="en" data-bs-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ui-components · web demo</title>
<link rel="stylesheet" href="./web_modules/bootstrap/dist/css/bootstrap.min.css">
<link rel="stylesheet" href="./web_modules/@xterm/xterm/css/xterm.css">
<link rel="stylesheet" href="./elements.css">
<link rel="stylesheet" href="./styles.css">
{{ importmap | safe }}
<script type="module" src="./app.js"></script>
</head>
<!-- Only the top padding is a utility: the bottom clears the debug bar and
     follows its collapsed state from the stylesheet. -->
<body class="pt-5 bg-body-tertiary">
<div class="container-fluid px-4 px-xl-5">
<div class="d-flex flex-column flex-md-row align-items-md-start gap-5">
<main class="flex-grow-1">
<h1 class="h4 mb-4">ui-components web demo</h1>
<!-- The whole form is one component around one state object; the controls,
     their labels and hints live in app-root's template (app_root.mhtml).
     The state arrives as a property from the script below and every commit
     comes back out as state-changed. -->
<app-root class="d-block"></app-root>
</main>
<!-- The same page rendered by the TUI runtime, compiled to wasm; tui.js
     reveals the pane once /tui (scripts/build-wasm.sh) is available. -->
<aside id="tui-pane" class="flex-shrink-0 d-none" data-qa="tui-pane">
<h2 class="h4 mb-4 text-body-secondary">the same page, in a terminal</h2>
<!-- The terminal wears its own Bootstrap theme: tui.js reads the custom
     properties resolved on this element for the xterm palette, and the
     stylesheet frame follows the same variables. -->
<div id="terminal" class="tui-screen" data-bs-theme="dark"></div>
<p class="text-body-secondary small mt-2 mb-0">Click a field or Tab around — Enter commits, F4 or a click opens pickers, Esc leaves.</p>
</aside>
</div>
</div>
<!-- The debug bar: notify events today, more tooling later; the handle
     collapses it to its edge. -->
<footer id="debug-bar" class="fixed-bottom bg-body border-top" data-qa="debug-bar">
<button id="debug-toggle" class="btn btn-sm w-100 py-0 text-body-secondary" aria-expanded="true" aria-controls="debug-body" title="Toggle the debug bar">&#9662;</button>
<div id="debug-body" class="debug-body container-fluid px-4 pb-2">
<h2 class="h6">notify events</h2>
<pre id="events" class="border bg-body p-2 small mb-0" data-qa="events"></pre>
</div>
</footer>
<script type="module">
import { wireStatePane } from './wiring.js';
// The state is a property (no attribute): the page owns the bootstrap.
// These are the values the markup used to pin as attributes.
const root = document.querySelector('app-root');
root.state = { date: '2026-07-07 00:00:00', start: '2026-07-07', end: '2026-07-11' };

const log = document.getElementById('events');
window.__events = [];
const record = (entry) => {
  window.__events.push(entry);
  log.textContent += JSON.stringify(entry) + '\n';
};

// The wiring subscribes once the component settled (children normalize
// empty members to null during the first update) and seeds the dedupe with
// that settled state — loading produces no traffic and no log entries.
await root.updateComplete;
const pane = wireStatePane({
  boot: root.state,
  apply: (state) => {
    root.state = state;
  },
  src: 'dom',
  record,
});
root.addEventListener('state-changed', (e) => pane.changed(e.detail.value));
// The debug bar collapses to its handle; the caret points where it moves.
const bar = document.getElementById('debug-bar');
const toggle = document.getElementById('debug-toggle');
toggle.addEventListener('click', () => {
  const collapsed = bar.classList.toggle('collapsed');
  toggle.textContent = collapsed ? '▴' : '▾';
  toggle.setAttribute('aria-expanded', String(!collapsed));
});
</script>
<script type="module" src="./tui.js"></script>
</body>
</html>
