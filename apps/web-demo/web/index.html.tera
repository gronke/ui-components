<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ui-components · web demo</title>
<link rel="stylesheet" href="/web_modules/bootstrap/dist/css/bootstrap.min.css">
<link rel="stylesheet" href="/elements.css">
<link rel="stylesheet" href="/styles.css">
{{ importmap | safe }}
<script type="module" src="/app.js"></script>
</head>
<body class="py-5 bg-body-tertiary">
<main class="container">
<h1 class="h4 mb-4">ui-components web demo</h1>
<input-date
  label="Date of purchase"
  hint="Format: YYYY-MM-DD"
  value="2026-07-07"
  min="2020-01-01"
  max="2030-12-31"
  class="mb-4 d-block"
></input-date>
<input-text
  label="Note"
  hint="Trimmed on commit; empty becomes null"
  placeholder="free text"
  allow-null
></input-text>
<h2 class="h6 mt-5">value-changed events</h2>
<pre id="events" class="border bg-body p-2 small" data-qa="events"></pre>
</main>
<script type="module">
// LitNotify events do not bubble; listen on each element itself.
const log = document.getElementById('events');
window.__events = [];
for (const el of document.querySelectorAll('input-date, input-text')) {
  el.addEventListener('value-changed', (e) => {
    const entry = { tag: el.tagName.toLowerCase(), ...e.detail };
    window.__events.push(entry);
    log.textContent += JSON.stringify(entry) + '\n';
  });
}
</script>
</body>
</html>
