<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ui-components · web demo</title>
<link rel="stylesheet" href="/web_modules/bootstrap/dist/css/bootstrap.min.css">
<link rel="stylesheet" href="/elements.css">
<link rel="stylesheet" href="/styles.css">
{{ importmap | safe }}
<script type="module" src="/app.js"></script>
</head>
<body class="py-5 bg-body-tertiary">
<main class="container">
<h1 class="h4 mb-4">ui-components web demo</h1>
<input-date
  label="Date of purchase"
  hint="Format: YYYY-MM-DD"
  value="2026-07-07"
  min="2020-01-01"
  max="2030-12-31"
  default-timezone="Europe/Berlin"
  show-timezone
  class="mb-4 d-block"
></input-date>
<input-text
  label="Note"
  hint="Trimmed on commit; empty becomes null"
  placeholder="free text"
  allow-null
  class="mb-4 d-block"
></input-text>
<input-number
  label="Amount"
  hint="Comma or dot decimals; dots group thousands"
  unit="€"
  allow-null
  class="mb-4 d-block"
></input-number>
<input-select
  label="Time zone"
  hint="Empty commits null once a default is set"
  default="Pick a zone"
  data-qa="select-demo"
  class="mb-4 d-block"
></input-select>
<input-textarea
  label="Comment"
  hint="Grows with its content up to max-lines"
  max-lines="6"
  placeholder="multi-line text"
></input-textarea>
<input-timezone
  label="Default time zone"
  hint="The browser zone list; empty commits null"
  default=""
  class="mb-4 d-block"
></input-timezone>
<h2 class="h6 mt-5">notify events</h2>
<pre id="events" class="border bg-body p-2 small" data-qa="events"></pre>
</main>
<script type="module">
// The option list is data, assigned as a property (ADR 0006).
const select = document.querySelector('input-select');
select.options = [
  { value: 'Europe/Amsterdam', short: 'Amsterdam' },
  { value: 'Europe/Berlin', short: 'Berlin' },
  { value: 'America/New_York', short: 'New_York' },
  { value: 'Pacific/Auckland', short: 'Auckland' },
];
// LitNotify events do not bubble; listen on each element itself.
// A ZonedDateTime detail serializes via its toJSON (ISO string).
const log = document.getElementById('events');
window.__events = [];
for (const el of document.querySelectorAll('input-date, input-text, input-number, input-select, input-textarea, input-timezone')) {
  for (const type of ['value-changed', 'date-changed', 'timezone-changed']) {
    el.addEventListener(type, (e) => {
      const entry = { tag: el.tagName.toLowerCase(), type, ...e.detail };
      window.__events.push(entry);
      log.textContent += JSON.stringify(entry) + '\n';
    });
  }
}
</script>
</body>
</html>
