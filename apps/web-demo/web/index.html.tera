<!doctype html>
<!-- The stylesheet ships both theme variants; the site wears light and the
     terminal pane wears dark for this preview — either side could flip. -->
<html lang="en" data-bs-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ui-components · web demo</title>
<link rel="stylesheet" href="/web_modules/bootstrap/dist/css/bootstrap.min.css">
<link rel="stylesheet" href="/web_modules/@xterm/xterm/css/xterm.css">
<link rel="stylesheet" href="/elements.css">
<link rel="stylesheet" href="/styles.css">
{{ importmap | safe }}
<script type="module" src="/app.js"></script>
</head>
<!-- Only the top padding is a utility: the bottom clears the debug bar and
     follows its collapsed state from the stylesheet. -->
<body class="pt-5 bg-body-tertiary">
<div class="container-fluid px-4 px-xl-5">
<div class="d-flex flex-column flex-md-row align-items-md-start gap-5">
<main class="flex-grow-1">
<h1 class="h4 mb-4">ui-components web demo</h1>
<!-- The date hugs its content by default (the catalog's fit-content);
     the demo opts into the full column with w-100, like the terminal. -->
<input-date
  label="Date of purchase"
  hint="Format: YYYY-MM-DD"
  value="2026-07-07"
  min="2020-01-01"
  max="2030-12-31"
  default-timezone="Europe/Berlin"
  show-timezone
  class="mb-4 d-block w-100"
></input-date>
<input-date-range
  label="Stay"
  hint="The end never precedes the start; both ends commit the interval"
  start="2026-07-07"
  end="2026-07-11"
  class="mb-4 d-block"
></input-date-range>
<input-text
  label="Note"
  hint="Trimmed on commit; empty becomes null"
  placeholder="free text"
  allow-null
  class="mb-4 d-block"
></input-text>
<input-number
  label="Amount"
  hint="Comma or dot decimals; dots group thousands"
  unit="€"
  allow-null
  class="mb-4 d-block"
></input-number>
<input-select
  label="Time zone"
  hint="Empty commits null once a default is set"
  default="Pick a zone"
  data-qa="select-demo"
  class="mb-4 d-block"
></input-select>
<input-textarea
  label="Comment"
  hint="Grows with its content up to max-lines"
  max-lines="6"
  placeholder="multi-line text"
></input-textarea>
<input-timezone
  label="Default time zone"
  hint="The browser zone list; empty commits null"
  default=""
  class="mb-4 d-block"
></input-timezone>
</main>
<!-- The same page rendered by the TUI runtime, compiled to wasm; tui.js
     reveals the pane once /tui (scripts/build-wasm.sh) is available. -->
<aside id="tui-pane" class="flex-shrink-0 d-none" data-qa="tui-pane">
<h2 class="h4 mb-4 text-body-secondary">the same page, in a terminal</h2>
<!-- The terminal wears its own Bootstrap theme: tui.js reads the custom
     properties resolved on this element for the xterm palette, and the
     stylesheet frame follows the same variables. -->
<div id="terminal" class="tui-screen" data-bs-theme="dark"></div>
<p class="text-body-secondary small mt-2 mb-0">Click a field or Tab around — Enter commits, F4 or a click opens pickers, Esc leaves.</p>
</aside>
</div>
</div>
<!-- The debug bar: notify events today, more tooling later; the handle
     collapses it to its edge. -->
<footer id="debug-bar" class="fixed-bottom bg-body border-top" data-qa="debug-bar">
<button id="debug-toggle" class="btn btn-sm w-100 py-0 text-body-secondary" aria-expanded="true" aria-controls="debug-body" title="Toggle the debug bar">&#9662;</button>
<div id="debug-body" class="debug-body container-fluid px-4 pb-2">
<h2 class="h6">notify events</h2>
<pre id="events" class="border bg-body p-2 small mb-0" data-qa="events"></pre>
</div>
</footer>
<script type="module">
// The option list is data, assigned as a property (ADR 0006).
const select = document.querySelector('input-select');
select.options = [
  { value: 'Europe/Amsterdam', short: 'Amsterdam' },
  { value: 'Europe/Berlin', short: 'Berlin' },
  { value: 'America/New_York', short: 'New_York' },
  { value: 'Pacific/Auckland', short: 'Auckland' },
];
// LitNotify events do not bubble; listen on each element itself. The
// nested filter keeps the log to page-level elements (composites carry
// their own children in the light DOM), mirroring the terminal pane.
// A ZonedDateTime detail serializes via its toJSON (ISO string).
const log = document.getElementById('events');
window.__events = [];
const tags = 'input-date, input-date-range, input-text, input-number, input-select, input-textarea, input-timezone';
for (const el of [...document.querySelectorAll(tags)].filter((el) => !el.parentElement?.closest(tags))) {
  for (const type of ['value-changed', 'date-changed', 'timezone-changed', 'start-changed', 'end-changed']) {
    el.addEventListener(type, (e) => {
      const entry = { tag: el.tagName.toLowerCase(), type, ...e.detail };
      window.__events.push(entry);
      log.textContent += JSON.stringify(entry) + '\n';
    });
  }
}
// The debug bar collapses to its handle; the caret points where it moves.
const bar = document.getElementById('debug-bar');
const toggle = document.getElementById('debug-toggle');
toggle.addEventListener('click', () => {
  const collapsed = bar.classList.toggle('collapsed');
  toggle.textContent = collapsed ? '▴' : '▾';
  toggle.setAttribute('aria-expanded', String(!collapsed));
});
</script>
<script type="module" src="/tui.js"></script>
</body>
</html>
