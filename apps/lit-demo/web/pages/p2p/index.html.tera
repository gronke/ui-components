<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<base href="../">
<script src="./theme.js"></script>
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<meta name="theme-color" content="#0d6efd">
<link rel="manifest" href="manifest.json">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<link rel="apple-touch-icon" href="icon.svg">
<title>lit-todo · p2p</title>
<link rel="stylesheet" href="./web_modules/bootstrap/dist/css/bootstrap.min.css">
<link rel="stylesheet" href="./todo.css">
<link rel="stylesheet" href="./p2p/p2p.css">
{{ importmap | safe }}
<script type="module" src="./@gronke/lit-todo/todo-app.js"></script>
<script type="module" src="./p2p/p2p.js"></script>
<script type="module" src="./refocus.js"></script>
</head>
<body class="py-4">
<main class="container">
<!-- Pairing-first: the wrappers are the screen gates (plain divs, so the
     UA [hidden] rule wins) — the page glue flips them on the wizard's mode. -->
<div class="bar mb-3" hidden><status-navbar></status-navbar></div>
<div class="todo-pane" hidden><todo-app class="d-block mb-4"></todo-app></div>
<div class="pairing-pane"><pair-wizard></pair-wizard></div>
<footer class="text-center small mt-3">
<a class="link-secondary" href="./">← share through the server instead</a>
</footer>
</main>
</body>
</html>
